#include "adv360_custom.h"  // urob key order, vendored from zmk-helpers v2

/* map 360's extra keys */
#define X_LT    &none &kp N5 &kp N1 &kp N2 &kp N3 &kp N4 &bootloader     &bootloader &none &kp N7 &kp N8 &kp N9 &none &studio_unlock \
                &kp TAB
#define X_MT    &kp N5 &to 0
#define X_RT    &kp RALT

#define X_LM    &kp ESC
#define X_MM    &tog 8 &tog 8
#define X_RM    &kp RET

#define X_LB    &kp LSHFT
#define X_RB    &kp RSHFT


#define X_LH    &kp LCTRL &kp LGUI &kp LALT &kp LEFT &kp RIGHT     &kp UP &kp DOWN &none &none &none \
                &kt LALT    &tog 8            &kp RGUI  &kp RCTRL
#define X_MH    &kp HOME    &kp PG_UP
#define X_RH    &kp END     &kp PG_DN

/* gaming version */
#define G_X_LT  &kp ESC &kp N6 &kp N1 &kp N2 &kp N3 &kp N4 &to 0     &bootloader &none &kp N7 &kp N8 &kp N9 &none &studio_unlock \
                &kp ESC
#define G_X_MT  &kp N5 &to 0

#define G_X_LM  &kp H
#define G_X_MM  &kp G &tog 8
#define G_X_RM  &kp RET

#define G_X_LB  &kp B

#define G_X_LH  &kp I     &kp LGUI &kp RET &kp LEFT &kp RIGHT     &kp UP &kp DOWN &none &none &none \
                &kt LALT     &tog 8            &kp RGUI  &kp RCTRL
#define G_X_MH  &kp M       &kp PG_UP
#define G_X_RH  &kp T       &kp PG_DN

/* activate bluetooth */
#define CONFIG_WIRELESS 1

/* leds and backlights
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
 */

/* source the main keymap */
#include "base.keymap"


/* use urob's key order for the Advantage 360 pro
 *
 * Upstream ZMK's default transform interleaves the thumb keys with the main
 * rows. The keymap is written in urob's order (rows first, thumbs last), so
 * both the matrix transform and the physical layout used by ZMK Studio are
 * re-ordered here. The key geometry is copied from upstream's
 * adv360pro-layouts.dtsi. The right half keeps upstream's col-offset of 10.
 */
#include <dt-bindings/zmk/matrix_transform.h>

&matrix_transform0 {
    map = <
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18) RC(4,19)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17) RC(3,18) RC(3,19)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17) RC(2,18) RC(2,19)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18) RC(1,19)
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19)
        RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(0,7) RC(0,8) RC(1,9) RC(1,10) RC(0,11) RC(0,12)
        RC(0,9) RC(0,10)
    >;
};

&physical_layout0 {
    display-name = "urob";
    keys  //                     w   h    x    y     rot    rx    ry
        = <&key_physical_attrs 125 100    0   25       0     0     0>
        , <&key_physical_attrs 100 100  125   25       0     0     0>
